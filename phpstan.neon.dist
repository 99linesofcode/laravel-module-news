includes:
    - phpstan-baseline.neon

parameters:
    level: 5
    scanDirectories:
        - stubs
    scanFiles:
        - _ide_helper_models.php
    paths:
        - src
    tmpDir: build/phpstan
    databaseMigrationsPath:
        - database/migrations
        - vendor/99linesofcode/laravel-module-user/database/migrations
